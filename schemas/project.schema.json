{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project.yaml",
  "description": "Project configuration. See spec/10-formats.md §10.1.",
  "type": "object",
  "required": [
    "spec_version",
    "id",
    "name",
    "workflow",
    "gates",
    "setting"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "type": "string",
      "const": "0.2"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "enum": [
        "novel",
        "short-story",
        "serial"
      ]
    },
    "gates": {
      "enum": [
        "none",
        "milestones",
        "all"
      ]
    },
    "seed": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "pov": {
          "type": "string"
        },
        "tense": {
          "type": "string"
        },
        "target_length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "layers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/layerRef"
      },
      "description": "The layers the project reads, from the base up. Absent or empty: a self-contained project. See spec/02-layout.md §2.2."
    },
    "resolution": {
      "enum": [
        "precedence",
        "recency",
        "fill"
      ],
      "default": "precedence",
      "description": "How rows from different layers resolve. See spec/05-sources.md §5.4."
    },
    "setting": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "original",
            "established"
          ]
        },
        "fidelity": {
          "enum": [
            "strict",
            "flexible",
            "au"
          ]
        },
        "fidelity_notes": {
          "type": "string",
          "description": "Free text: latitude of the project's own, such as what is load-bearing. Established only. See spec/06-divergence.md §6.3."
        },
        "cutoff": {
          "$ref": "#/$defs/rulerPoint"
        },
        "cutoffs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/rulerPoint"
          },
          "minProperties": 1,
          "description": "Keyed by base package id. Universe projects only."
        },
        "follow": {
          "enum": [
            "retelling",
            "branch"
          ],
          "default": "retelling",
          "description": "Whether canon after the divergence point still happens. See spec/06-divergence.md §6.6."
        },
        "divergence_point": {
          "$ref": "#/$defs/rulerPoint"
        },
        "divergence_points": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/rulerPoint"
          },
          "minProperties": 1,
          "description": "Keyed by base package id. Universe projects only."
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+(:[0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "The project order: every segment of the base's ruler, once each. Established only. See spec/06-divergence.md §6.8."
        },
        "orders": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]+(:[0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "minProperties": 1,
          "description": "Keyed by base package id: the bases the project reorders. Universe projects only."
        },
        "temporal_model": {
          "enum": [
            "linear",
            "frames"
          ],
          "default": "linear"
        }
      }
    },
    "calendar": {
      "$ref": "#/$defs/calendar"
    },
    "notation": {
      "$ref": "#/$defs/notation"
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "litrpg": {
          "type": "boolean",
          "default": false
        },
        "languages": {
          "type": "boolean",
          "default": false
        },
        "travel": {
          "type": "boolean",
          "default": false,
          "description": "Routes and journey times. See spec/09-modules.md §9.4."
        },
        "mysteries": {
          "type": "boolean",
          "default": false,
          "description": "Mysteries, clues, and fair play. See spec/09-modules.md §9.5."
        },
        "lineage": {
          "type": "boolean",
          "default": false,
          "description": "Parentage, ancestry, and titles. See spec/09-modules.md §9.6."
        }
      }
    },
    "serial": {
      "type": "object",
      "additionalProperties": false,
      "description": "Serial workflow only. See spec/13-workflows.md §13.3.",
      "properties": {
        "released": {
          "enum": [
            "locked",
            "revisable"
          ],
          "default": "locked"
        }
      }
    }
  },
  "allOf": [
    {
      "description": "A project with a universe layer uses the per-base maps, never the single-cutoff keys.",
      "if": {
        "properties": {
          "layers": {
            "contains": {
              "type": "string",
              "pattern": "^universe:"
            }
          }
        },
        "required": [
          "layers"
        ]
      },
      "then": {
        "properties": {
          "setting": {
            "required": [
              "cutoffs"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "cutoff"
                  ]
                },
                {
                  "required": [
                    "divergence_point"
                  ]
                },
                {
                  "required": [
                    "order"
                  ]
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "setting": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "cutoffs"
                  ]
                },
                {
                  "required": [
                    "divergence_points"
                  ]
                },
                {
                  "required": [
                    "orders"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "description": "Fidelity applies only to established settings.",
      "if": {
        "properties": {
          "setting": {
            "properties": {
              "type": {
                "const": "original"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "setting": {
            "not": {
              "required": [
                "fidelity"
              ]
            }
          }
        }
      }
    },
    {
      "description": "The serial block is valid only for the serial workflow.",
      "if": {
        "required": [
          "serial"
        ]
      },
      "then": {
        "properties": {
          "workflow": {
            "const": "serial"
          }
        }
      }
    },
    {
      "description": "A branch needs its divergence point(s).",
      "if": {
        "properties": {
          "setting": {
            "properties": {
              "follow": {
                "const": "branch"
              }
            },
            "required": [
              "follow"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "setting": {
            "anyOf": [
              {
                "required": [
                  "divergence_point"
                ]
              },
              {
                "required": [
                  "divergence_points"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "description": "follow, divergence points, fidelity notes, cutoffs, and the project order apply only to established settings.",
      "if": {
        "properties": {
          "setting": {
            "properties": {
              "type": {
                "const": "original"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "setting": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "follow"
                  ]
                },
                {
                  "required": [
                    "divergence_point"
                  ]
                },
                {
                  "required": [
                    "divergence_points"
                  ]
                },
                {
                  "required": [
                    "fidelity_notes"
                  ]
                },
                {
                  "required": [
                    "order"
                  ]
                },
                {
                  "required": [
                    "orders"
                  ]
                },
                {
                  "required": [
                    "cutoff"
                  ]
                },
                {
                  "required": [
                    "cutoffs"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "description": "An established project has at least one package or project layer. See spec/06-divergence.md §6.1.",
      "if": {
        "properties": {
          "setting": {
            "properties": {
              "type": {
                "const": "established"
              }
            }
          }
        },
        "required": [
          "setting"
        ]
      },
      "then": {
        "required": [
          "layers"
        ],
        "properties": {
          "layers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "description": "An original project has no layers: a project that reads a package or an earlier book is established. See spec/06-divergence.md §6.1.",
      "if": {
        "properties": {
          "setting": {
            "properties": {
              "type": {
                "const": "original"
              }
            }
          }
        },
        "required": [
          "setting"
        ]
      },
      "then": {
        "properties": {
          "layers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "description": "Only an original project declares a calendar; an established one dates in its stack's (spec §4.13).",
      "if": {
        "properties": {
          "setting": {
            "properties": {
              "type": {
                "const": "established"
              }
            }
          }
        },
        "required": [
          "setting"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "calendar"
              ]
            },
            {
              "required": [
                "notation"
              ]
            }
          ]
        }
      }
    },
    {
      "description": "A notation needs calendar: iso.",
      "if": {
        "required": [
          "notation"
        ]
      },
      "then": {
        "required": [
          "calendar"
        ],
        "properties": {
          "calendar": {
            "const": "iso"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "rulerPoint": {
      "type": "string",
      "description": "work{:index}[+HH:MM:SS[.fraction]] — see spec/04-temporal.md §4.2. Validity against the ruler (levels, counts, segments, timed level) is checked by the host, not the schema.",
      "pattern": "^[A-Za-z][A-Za-z0-9-]*(:[1-9]\\d*)*(\\+\\d{2,}:[0-5]\\d:[0-5]\\d(\\.\\d+)?)?$"
    },
    "layerRef": {
      "type": "string",
      "description": "<package-id>@<version>, universe:<id>@<version>, or project:<id>@chapter-<NN>. See spec/02-layout.md §2.2.",
      "pattern": "^(([a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*){0,2})|universe:[a-z0-9]+(-[a-z0-9]+)*)@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$|^project:[a-z0-9]+(-[a-z0-9]+)*@chapter-\\d{2,}$"
    },
    "calendar": {
      "description": "The world's calendar (spec §4.13): iso, or a custom calendar of eras and optional months. The order rules for eras (only the first counts down, and it is not last; every era counting up except the last gives years) are host validations, §14.2.",
      "oneOf": [
        {
          "const": "iso"
        },
        {
          "type": "object",
          "required": [
            "eras"
          ],
          "additionalProperties": false,
          "properties": {
            "eras": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9]*$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "counts": {
                    "const": "down"
                  },
                  "years": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "not": {
                  "required": [
                    "counts",
                    "years"
                  ]
                }
              }
            },
            "months": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "days"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "days": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "notation": {
      "type": "string",
      "pattern": "^[a-z0-9]{3,8}(-[a-z0-9]{3,8})*$",
      "description": "The calendar the work writes dates in: a Unicode BCP 47 calendar identifier, such as gregory or japanese. Only with calendar: iso (spec §4.13)."
    }
  }
}
